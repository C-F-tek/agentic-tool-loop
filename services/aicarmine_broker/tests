def test_min_chars_threshold():
    """Verifica che threshold min_chars sia stato ridotto da 2200 a 1500."""
    from services.aicarmine_broker.config.entry_points_config import EvidenceContractThresholds
    
    thresholds = EvidenceContractThresholds()
    assert thresholds.min_chars == 1500, f"Expected 1500, got {thresholds.min_chars}"
    assert thresholds.min_chars_reduced is True


def test_entry_point_info_dataclass():
    """Verifica che EntryPointInfo dataclass funzioni correttamente."""
    ep = EntryPointInfo(
        path="services/main.py",
        symbol_name="main",
        line_number=10,
        function_signature="main()",
        is_entry_point=True
    )
    
    assert ep.path == "services/main.py"
    assert ep.symbol_name == "main"
    assert ep.line_number == 10
    assert ep.function_signature == "main()"
    assert ep.is_entry_point is True


def test_entry_point_analyzer_init():
    """Verifica che EntryPointAnalyzer si inizializzi correttamente."""
    repo_root = Path.cwd()
    analyzer = EntryPointAnalyzer(repo_root)
    
    assert analyzer.repo_root == repo_root


def test_scan_for_functions_empty_file():
    """Verifica che scan_for_functions gestisca file vuoti."""
    analyzer = EntryPointAnalyzer(Path.cwd())
    
    # Crea un file temporaneo vuoto
    temp_file = Path("@workspace/temp_empty.py")
    temp_file.write_text("")
    
    try:
        functions = analyzer.scan_for_functions(temp_file)
        assert functions == [], f"Expected empty list, got {functions}"
    finally:
        temp_file.unlink(missing_ok=True)


def test_scan_for_functions_simple_function():
    """Verifica che scan_for_functions trovi funzioni semplici."""
    analyzer = EntryPointAnalyzer(Path.cwd())
    
    # Crea un file con una funzione semplice
    temp_file = Path("@workspace/temp_func.py")
    temp_file.write_text("""
def main():
    '''Main entry point'''
    pass

def helper(x):
    return x + 1
""")
    
    try:
        functions = analyzer.scan_for_functions(temp_file)
        
        assert len(functions) >= 2, f"Expected at least 2 functions, got {len(functions)}"
        
        # Verifica che 'main' sia identificato come entry point
        main_funcs = [f for f in functions if f["name"] == "main"]
        assert len(main_funcs) == 1, f"Expected 1 main function, got {len(main_funcs)}"
        assert main_funcs[0]["is_entry_point"] is True
        
        # Verifica che 'helper' non sia identificato come entry point
        helper_funcs = [f for f in functions if f["name"] == "helper"]
        assert len(helper_funcs) == 1
        assert helper_funcs[0]["is_entry_point"] is False
    finally:
        temp_file.unlink(missing_ok=True)


def test_identify_entry_points_with_contract():
    """Verifica che identify_entry_points lavori con contratto valido."""
    analyzer = EntryPointAnalyzer(Path.cwd())
    
    contract = {
        "covered_owner_paths": ["@workspace/temp_main.py"]
    }
    
    # Crea un file principale
    temp_main = Path("@workspace/temp_main.py")
    temp_main.write_text("""
def main():
    '''Main entry point'''
    print("Hello")
""")
    
    try:
        entry_points = analyzer.identify_entry_points(contract)
        
        assert isinstance(entry_points, list)
        # Potrebbe essere vuoto se il file non esiste nel percorso corretto
    finally:
        temp_main.unlink(missing_ok=True)


def test_calculate_coverage_zero_discovered():
    """Verifica che calculate_coverage gestisca caso zero discovered."""
    analyzer = EntryPointAnalyzer(Path.cwd())
    
    result = analyzer.calculate_coverage([], [])
    assert result == 0.0


def test_calculate_coverage_full_coverage():
    """Verifica che calculate_coverage calcoli coverage completa."""
    analyzer = EntryPointAnalyzer(Path.cwd())
    
    ep_list = [EntryPointInfo(
        path="test.py",
        symbol_name="main",
        line_number=1,
        function_signature="main()",
        is_entry_point=True
    )]
    
    verified_reads = [{"path": "test.py"}]
    
    result = analyzer.calculate_coverage(ep_list, verified_reads)
    assert result == 1.0


