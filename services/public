# services/public_payload/payload_shaper - Public payload shaping for OpenWebUI
#
# This module provides terminal payload shaping for the OpenWebUI public surface.
# It preserves the existing public shape guarantees from END_TO_END_AGENTIC_FLOW.md
# and SERVICES_MODULE_TECHNICAL_REFERENCE.md.
#
# All public payload shaping must use this module instead of ad-hoc payload assembly.

from __future__ import annotations

import json
from typing import Optional, Any
from pathlib import Path


class PublicPayloadShaper:
    """Public Payload Shaper.
    
    Shapes terminal payloads for OpenWebUI public surface.
    Preserves the stable public shape across completed and non-completed jobs.
    """
    
    # Required top-level keys for terminal payload
    REQUIRED_TOP_LEVEL_KEYS = [
        "payload_index_for_30b",
        "priority_evidence_for_30b",
        "openwebui_usage",
        "tool_context_for_30b",
    ]
    
    def __init__(self, job_root: str):
        self.job_root = Path(job_root)
    
    def shape_terminal_payload(self, job_id: str) -> dict:
        """Shape terminal payload for OpenWebUI.
        
        Returns the complete public payload shape with all required fields.
        """
        # Load job state
        job = self._load_job(job_id)
        if not job:
            return self._empty_payload(job_id)
        
        # Load terminal response if available
        terminal_response = self._load_terminal_response(job_id)
        
        # Build payload components
        payload_index = self._build_payload_index(job, terminal_response)
        priority_evidence = self._build_priority_evidence(job_id)
        tool_context = self._build_tool_context(job_id)
        openwebui_usage = self._build_openwebui_usage(job)
        
        return {
            "ok": job.state.value in ("terminal_completed",),
            "service": "agentic_loop",
            "mode": "terminal",
            "required_top_level_keys": self.REQUIRED_TOP_LEVEL_KEYS,
            "payload_index_for_30b": payload_index,
            "priority_evidence_for_30b": priority_evidence,
            "openwebui_usage": openwebui_usage,
            "tool_context_for_30b": tool_context,
            "result": terminal_response or self._build_result_from_job(job),
            "materialization_report": {
                "owner": "3572_broker",
                "status": "complete",
                "inline_content_verified": True,
            },
        }
    
    def _load_job(self, job_id: str) -> Optional[dict]:
        """Load job state from filesystem."""
        job_file = self.job_root / "jobs" / f"{job_id}.json"
        if not job_file.exists():
            return None
        
        try:
            with open(job_file, 'r', encoding='utf-8') as f:
                return json.load(f)
        except (json.JSONDecodeError, IOError):
            return None
    
    def _load_terminal_response(self, job_id: str) -> Optional[dict]:
        """Load terminal response from final.json."""
        final_file = self.job_root / "final" / f"{job_id}.json"
        if not final_file.exists():
            return None
        
        try:
            with open(final_file, 'r', encoding='utf-8') as f:
                return json.load(f)
        except (json.JSONDecodeError, IOError):
            return None
    
    def _build_payload_index(self, job: dict, terminal_response: Optional[dict]) -> dict:
        """Build payload_index_for_30b navigation surface."""
        items = []
        
        # Add tool-result items from job events
        events = job.get("events", [])
        for event in events:
            if event.get("event") == "tool_result":
                items.append({
                    "source": "tool-result",
                    "tool_name": event.get("tool_name", ""),
                    "primary_location": "tool_context_for_30b.artifacts[*].artifact",
                    "has_inline_content": True,
                })
        
        return {
            "items": items,
            "total_items": len(items),
            "internal_job_status": job.get("state", "unknown"),
        }
    
    def _build_priority_evidence(self, job_id: str) -> dict:
        """Build priority_evidence_for_30b high-priority evidence."""
        priority_items = []
        
        # Collect from tool-results directory
        tool_results_dir = self.job_root / "tool-results"
        if tool_results_dir.exists():
            for result_file in tool_results_dir.glob("*.json"):
                try:
                    with open(result_file, 'r', encoding='utf-8') as f:
                        data = json.load(f)
                        if isinstance(data, dict):
                            if data.get("kind") == "code_edit_proposal":
                                priority_items.append({
                                    "type": "code_edit_proposal",
                                    "target_file": data.get("target_file", ""),
                                    "edit_kind": data.get("edit_kind", ""),
                                    "unified_diff": data.get("unified_diff", ""),
                                })
                            elif "content" in data and data.get("repo_path"):
                                priority_items.append({
                                    "type": "repo_read",
                                    "repo_path": data.get("repo_path", ""),
                                    "line_count": data.get("line_count", 0),
                                })
                except (json.JSONDecodeError, IOError):
                    continue
        
        return {
            "items": priority_items,
            "total_priority": len(priority_items),
        }
    
    def _build_tool_context(self, job_id: str) -> str:
        """Build tool_context_for_30b pretty-printed JSON string."""
        artifacts = []
        
        # Collect from tool-results directory
        tool_results_dir = self.job_root / "tool-results"
        if tool_results_dir.exists():
            for result_file in tool_results_dir.glob("*.json"):
                try:
                    with open(result_file, 'r', encoding='utf-8') as f:
                        data = json.load(f)
                        if data:
                            artifacts.append({
                                "artifact_id": result_file.name,
                                "source": "tool-result",
                                "artifact": data,
                            })
                except (json.JSONDecodeError, IOError):
                    continue
        
        context = {
            "artifacts": artifacts,
            "total_artifacts": len(artifacts),
            "limit": 100,
            "partial_products_for_30b": [],
        }
        
        return json.dumps(context, indent=2, ensure_ascii=False)
    
    def _build_openwebui_usage(self, job: dict) -> dict:
        """Build openwebui_usage runtime instructions."""
        return {
            "internal_job_status": job.get("state", "unknown"),
            "instructions": [
                "Read payload_index_for_30b for navigation",
                "Check priority_evidence_for_30b for high-priority content",
                "Parse tool_context_for_30b for complete tool evidence",
            ],
            "note": "Local paths and SQLite IDs are not substitutes for inline content",
        }
    
    def _build_result_from_job(self, job: dict) -> dict:
        """Build result from job state when no terminal response available."""
        return {
            "job_id": job.get("job_id", ""),
            "state": job.get("state", "unknown"),
            "final_answer": job.get("final_answer"),
            "error_message": job.get("error_message"),
            "history": self._build_public_history(job),
        }
    
    def _build_public_history(self, job: dict) -> list:
        """Build agentic_terminal_public_history_ledger.v1 from job events."""
        history = []
        events = job.get("events", [])
        
        for event in events:
            if event.get("event") == "tool_result":
                history.append({
                    "step": event.get("step", 0),
                    "action": event.get("action", ""),
                    "tool": event.get("tool_name", ""),
                    "reason": event.get("reason", ""),
                    "result_facts": event.get("result", ""),
                })
        
        return history
    
    def _empty_payload(self, job_id: str) -> dict:
        """Return empty payload when job not found."""
        return {
            "ok": False,
            "service": "agentic_loop",
            "mode": "terminal",
            "required_top_level_keys": self.REQUIRED_TOP_LEVEL_KEYS,
            "payload_index_for_30b": {"items": [], "total_items": 0},
            "priority_evidence_for_30b": {"items": [], "total_priority": 0},
            "openwebui_usage": {"instructions": [], "note": "Job not found"},
            "tool_context_for_30b": "[]",
            "result": {"job_id": job_id, "error": "Job not found"},
        }


# Module-level singleton
_payload_shaper: Optional[PublicPayloadShaper] = None

def get_payload_shaper(job_root: str) -> PublicPayloadShaper:
    """Get the PublicPayloadShaper singleton."""
    global _payload_shaper
    if _payload_shaper is None:
        _payload_shaper = PublicPayloadShaper(job_root)
    return _payload_shaper

def shape_terminal_payload(job_id: str, job_root: str) -> dict:
    """Convenience function to shape terminal payload."""
    return get_payload_shaper(job_root).shape_terminal_payload(job_id)