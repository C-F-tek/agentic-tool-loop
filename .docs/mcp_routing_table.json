{
  "schema": "aicarmine_mcp_routing_table.v1",
  "version": "1.0.0",
  "description": "Compact intent-to-tool routing table for immediate symbol resolution without thinking overhead. Reduces token usage by ~300 tokens/tool call.",
  "routing_rules": [
    {"intent": "read_file|leggi_file|read_content", "server": "aicarmine-codex-app", "tool": "aicarmine_repo_read", "params": "path, max_chars"},
    {"intent": "list_files|elenca_file|ls", "server": "aicarmine-codex-app", "tool": "aicarmine_repo_list_files", "params": "path, glob"},
    {"intent": "tree|albero|structure", "server": "aicarmine-codex-app", "tool": "aicarmine_repo_tree", "params": "path, max_depth"},
    {"intent": "search_code|cerca_codice|grep", "server": "aicarmine-repo-search-det", "tool": "aicarmine_repo_search_rg", "params": "query, path"},
    {"intent": "find_files|trova_file|fd", "server": "aicarmine-repo-search-det", "tool": "aicarmine_repo_search_fd", "params": "pattern, path"},
    {"intent": "ast_grep|semantic_search|ast", "server": "aicarmine-repo-search-det", "tool": "aicarmine_repo_search_ast_grep", "params": "pattern, lang"},
    {"intent": "symbols|ctags|definitions", "server": "aicarmine-repo-search-det", "tool": "aicarmine_repo_search_ctags", "params": "path"},
    {"intent": "tree_sitter|parse|ast_parse", "server": "aicarmine-repo-search-det", "tool": "aicarmine_repo_search_tree_sitter_parse", "params": "path"},
    {"intent": "jq|json_query", "server": "aicarmine-repo-search-det", "tool": "aicarmine_repo_search_jq", "params": "query, path"},
    {"intent": "git_log|storia|commits", "server": "aicarmine-git-readonly", "tool": "aicarmine_git_readonly_log", "params": "rev, max_count"},
    {"intent": "git_show|commit_detail", "server": "aicarmine-git-readonly", "tool": "aicarmine_git_readonly_show", "params": "rev"},
    {"intent": "git_diff|diff|cambiamenti", "server": "aicarmine-git-readonly", "tool": "aicarmine_git_readonly_diff", "params": "base, head"},
    {"intent": "git_blame|chi_scritto", "server": "aicarmine-git-readonly", "tool": "aicarmine_git_readonly_blame", "params": "path"},
    {"intent": "git_branch|compare|branch_diff", "server": "aicarmine-git-readonly", "tool": "aicarmine_git_readonly_branch_compare", "params": "branch"},
    {"intent": "job_status|stato_job", "server": "aicarmine-job-artifact", "tool": "aicarmine_job_artifact_list_jobs", "params": "limit"},
    {"intent": "job_summary|job_detail", "server": "aicarmine-job-artifact", "tool": "aicarmine_job_artifact_summary", "params": "job_id"},
    {"intent": "job_events|eventi_job", "server": "aicarmine-job-artifact", "tool": "aicarmine_job_artifact_events", "params": "job_id, tail"},
    {"intent": "job_final|risultato_job", "server": "aicarmine-job-artifact", "tool": "aicarmine_job_artifact_final", "params": "job_id"},
    {"intent": "job_tool_results|tool_output", "server": "aicarmine-job-artifact", "tool": "aicarmine_job_artifact_tool_results", "params": "job_id"},
    {"intent": "job_subturns|support_turns", "server": "aicarmine-job-artifact", "tool": "aicarmine_job_artifact_subturns", "params": "job_id"},
    {"intent": "job_rejections|rejected", "server": "aicarmine-job-artifact", "tool": "aicarmine_job_artifact_rejections", "params": "job_id"},
    {"intent": "job_planner|planner_payload", "server": "aicarmine-job-artifact", "tool": "aicarmine_job_artifact_planner_payload", "params": "job_id, step"},
    {"intent": "job_view|render_view", "server": "aicarmine-job-view", "tool": "aicarmine_job_view_render", "params": "view, job_id"},
    {"intent": "memory_search|cerca_memoria", "server": "aicarmine-project-memory", "tool": "aicarmine_project_memory_search", "params": "query, scope"},
    {"intent": "memory_get|leggi_memoria", "server": "aicarmine-project-memory", "tool": "aicarmine_project_memory_get", "params": "record_id or key"},
    {"intent": "memory_upsert|scrivi_memoria", "server": "aicarmine-project-memory", "tool": "aicarmine_project_memory_upsert_verified", "params": "key, value, source_type, source_ref"},
    {"intent": "memory_stale|obsoleta_memoria", "server": "aicarmine-project-memory", "tool": "aicarmine_project_memory_mark_stale", "params": "record_id"},
    {"intent": "memory_supersede|sostituisci_memoria", "server": "aicarmine-project-memory", "tool": "aicarmine_project_memory_supersede", "params": "record_id"},
    {"intent": "rag_search|semantico|rag_query", "server": "aicarmine-rag", "tool": "aicarmine_rag_context", "params": "query, top_k"},
    {"intent": "rag_status|indice_status", "server": "aicarmine-rag", "tool": "aicarmine_rag_index_status", "params": "repo"},
    {"intent": "rag_reindex|ricostruisci_indice", "server": "aicarmine-rag", "tool": "aicarmine_rag_reindex", "params": "mode, source"},
    {"intent": "validate_ruff|lint|linter", "server": "aicarmine-repo-validate", "tool": "aicarmine_repo_validate_ruff", "params": "path"},
    {"intent": "validate_pyright|type_check|tipi", "server": "aicarmine-repo-validate", "tool": "aicarmine_repo_validate_pyright", "params": "path"},
    {"intent": "validate_pytest|test|tests", "server": "aicarmine-repo-validate", "tool": "aicarmine_repo_validate_pytest", "params": "path, marker"},
    {"intent": "validate_shellcheck|shell_lint", "server": "aicarmine-repo-validate", "tool": "aicarmine_repo_validate_shellcheck", "params": "path"},
    {"intent": "validate_semgrep|security_scan", "server": "aicarmine-repo-validate", "tool": "aicarmine_repo_validate_semgrep", "params": "pattern, path"},
    {"intent": "validate_diffcheck|diff_check", "server": "aicarmine-repo-validate", "tool": "aicarmine_repo_validate_diffcheck", "params": "commands"},
    {"intent": "validate_probe|probe_run", "server": "aicarmine-repo-validate", "tool": "aicarmine_repo_validate_probe_run", "params": "profile_id, engine"},
    {"intent": "sqlite_query|query_db|database_query", "server": "aicarmine-sqlite-readonly", "tool": "aicarmine_sqlite_readonly_query", "params": "db, sql"},
    {"intent": "sqlite_schema|db_schema", "server": "aicarmine-sqlite-readonly", "tool": "aicarmine_sqlite_readonly_schema", "params": "db"},
    {"intent": "sqlite_list|databases", "server": "aicarmine-sqlite-readonly", "tool": "aicarmine_sqlite_readonly_list_databases", "params": "max_results"},
    {"intent": "apply_patch|scrivi_file|write", "server": "aicarmine-repo-code", "tool": "aicarmine_repo_code_apply_patch", "params": "path, old_text, new_text"},
    {"intent": "propose_edit|proponi_modifica", "server": "aicarmine-repo-code", "tool": "aicarmine_repo_code_propose_edit", "params": "path, request"},
    {"intent": "validate_unidiff|valida_diff", "server": "aicarmine-repo-code", "tool": "aicarmine_repo_code_unidiff_validate", "params": "diff"},
    {"intent": "git_apply_check|apply_verify", "server": "aicarmine-repo-code", "tool": "aicarmine_repo_code_git_apply_check", "params": "diff"},
    {"intent": "agentic_run|avvia_agentic|task", "server": "aicarmine-agentic-loop-client", "tool": "aicarmine_agentic_loop_run", "params": "task, confirm_agentic_loop"},
    {"intent": "agentic_status|stato_agentic", "server": "aicarmine-agentic-loop-client", "tool": "aicarmine_agentic_loop_status", "params": "job_id"},
    {"intent": "agentic_result|risultato_agentic", "server": "aicarmine-agentic-loop-client", "tool": "aicarmine_agentic_loop_result", "params": "job_id"},
    {"intent": "ensure_broker|avvia_broker", "server": "aicarmine-agentic-loop-client", "tool": "aicarmine_agentic_loop_ensure_broker", "params": "confirm_ensure_broker"},
    {"intent": "ensure_reranker|avvia_reranker", "server": "aicarmine-agentic-loop-client", "tool": "aicarmine_agentic_loop_ensure_reranker", "params": "confirm_ensure_reranker"},
    {"intent": "subagent_run|sottomodulo", "server": "aicarmine-local-subagent", "tool": "aicarmine_local_subagent_run_readonly", "params": "task, confirm_agentic_loop"},
    {"intent": "service_snapshot|snapshot_servizi", "server": "aicarmine-codex-ops", "tool": "aicarmine_service_state_snapshot", "params": "ports, patterns"},
    {"intent": "service_ports|porte", "server": "aicarmine-codex-ops", "tool": "aicarmine_service_state_ports", "params": "ports"},
    {"intent": "service_processes|processi", "server": "aicarmine-codex-ops", "tool": "aicarmine_service_state_processes", "params": "patterns"},
    {"intent": "service_logs|log_servizi", "server": "aicarmine-codex-ops", "tool": "aicarmine_service_state_logs", "params": "paths"},
    {"intent": "mcp_inventory|inventario_mcp", "server": "aicarmine-codex-ops", "tool": "aicarmine_mcp_inventory_probe", "params": "servers"},
    {"intent": "repo_status|stato_repo", "server": "aicarmine-repo-state", "tool": "aicarmine_repo_state_status", "params": "none"},
    {"intent": "repo_capabilities|capacita_repo", "server": "aicarmine-repo-state", "tool": "aicarmine_repo_state_capabilities", "params": "none"},
    {"intent": "health|salute|check", "server": "multiple", "tool": "*_health", "params": "none"},
    {"intent": "wily|complexity|cyclomatic|radon", "server": "aicarmine-wily", "tool": "wily_complexity", "params": "path"},
    {"intent": "maintainability|mantenibilit[àa]", "server": "aicarmine-wily", "tool": "wily_maintainability", "params": "path"},
    {"intent": "wily_list|python_files|py_files", "server": "aicarmine-wily", "tool": "wily_list_files", "params": "path, max_files"},
    {"intent": "wily_report|complexity_report", "server": "aicarmine-wily", "tool": "wily_report", "params": "path, recursive"}
  ],
  "usage_notes": {
    "primary": "Match user intent (Italian or English) to server+tool. Use first matching rule.",
    "fallback": "If no pattern matches, use MCP tools/list for discovery.",
    "params": "Only pass non-default parameters. Omit optional params when possible.",
    "confirmation": "Write-gated tools require explicit confirmation_value in the tool call."
  },
  "write_gated_tools": [
    "aicarmine_repo_code_apply_patch",
    "aicarmine_project_memory_upsert_verified",
    "aicarmine_project_memory_mark_stale",
    "aicarmine_project_memory_supersede",
    "aicarmine_agentic_loop_run",
    "aicarmine_agentic_loop_ensure_broker",
    "aicarmine_agentic_loop_ensure_reranker"
  ]
}