#     'openwebui': 'C:/Users/carmi/AI/venvs/openwebui',
#     'openvino': 'C:/Users/carmi/AI/venvs/openvino',
# }
# if tool in mapping:
#     os.environ['PYTHONPATH'] = mapping[tool]
# PY

# =============================================================================
# NOTES
# =============================================================================

# Per aggiungere nuove venv:
# 1. Crea la directory venfs/<nome_venv>
# 2. Avvia python -m venv
# 3. Installa pip: python -m pip install --upgrade pip
# 4. Aggiorna questa sezione con i nuovi percorsi

# Per installare pacchetti specifici in una venv:
# & <VENV>/Scripts/pip.exe install <package>

# Per verificare quale venv è attivo:
# & <VENV>/Scripts/python.exe -c "import sys; print(sys.executable)"