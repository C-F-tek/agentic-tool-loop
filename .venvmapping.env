# Venv Mapping Configuration
# Questo file mappa ogni venv agli strumenti/tool/script appropriati
# Copia questo file nella root del progetto e usa i launcher per attivare il venv corretto

# =============================================================================
# MAPPATURA VENV -> TOOL/SCOPO
# =============================================================================

# [LABTOOLS] - Broker interno, planner, validator, dispatcher
# Usato da: aicarmine_broker/*, application/*, tools/*
# Scopo: Gestione ciclo agentic loop, validazione decisioni planner
AICARMINE_BROKER_VENV=labtools
AICARMINE_BROKER_PATH=C:/Users/carmi/AI/venvs/labtools
AICARMINE_BROKER_PYTHON=C:/Users/carmi/AI/venvs/labtools/Scripts/python.exe
AICARMINE_BROKER_PIP=C:/Users/carmi/AI/venvs/labtools/Scripts/pip.exe

# [CODEINTERPRETER] - Jupyter notebook execution, code analysis
# Usato da: codice interpreter, analisi codice, esportazione risultati
AICARMINE_CODEINTERPRETER_VENV=codeinterpreter
AICARMINE_CODEINTERPRETER_PATH=C:/Users/carmi/AI/venvs/codeinterpreter
AICARMINE_CODEINTERPRETER_PYTHON=C:/Users/carmi/AI/venvs/codeinterpreter/Scripts/python.exe
AICARMINE_CODEINTERPRETER_PIP=C:/Users/carmi/AI/venvs/codeinterpreter/Scripts/pip.exe

# [EXECUTOR] - Command execution, safe command runner
# Usato da: aicarmine-executor-server, run-safe-command
# Scopo: Esecuzione comandi nel filesystem target repo
AICARMINE_EXECUTOR_VENV=executor
AICARMINE_EXECUTOR_PATH=C:/Users/carmi/AI/venvs/executor
AICARMINE_EXECUTOR_PYTHON=C:/Users/carmi/AI/venvs/executor/Scripts/python.exe
AICARMINE_EXECUTOR_PIP=C:/Users/carmi/AI/venvs/executor/Scripts/pip.exe

# [OPENWEBUI] - Interfaccia utente, dashboard, API publiche
# Usato da: open-webui, vulkan_bridge/app.py (public surface)
# Scopo: Rendering HTML, dashboard jobs, API pubbliche
AICARMINE_OPENWEBUI_VENV=openwebui
AICARMINE_OPENWEBUI_PATH=C:/Users/carmi/AI/venvs/openwebui
AICARMINE_OPENWEBUI_PYTHON=C:/Users/carmi/AI/venvs/openwebui/Scripts/python.exe
AICARMINE_OPENWEBUI_PIP=C:/Users/carmi/AI/venvs/openwebui/Scripts/pip.exe

# [OPENVINO] - Inference CPU, modelli ottimizzati
# Usato da: ovms-reranker-npu, inference locale
# Scopo: Reranking, embedding su hardware CPU/NPU
AICARMINE_OPENVINO_VENV=openvino
AICARMINE_OPENVINO_PATH=C:/Users/carmi/AI/venvs/openvino
AICARMINE_OPENVINO_PYTHON=C:/Users/carmi/AI/venvs/openvino/Scripts/python.exe
AICARMINE_OPENVINO_PIP=C:/Users/carmi/AI/venvs/openvino/Scripts/pip.exe

# =============================================================================
# DEFAULT SELECTION RULES
# =============================================================================

# Seleziona automaticamente il venv in base al tool chiamato:
# - repo_read, repo_search, repo_tree, repo_apply_patch -> labtools
# - jupyter_execute, code_interpreter -> codeinterpreter  
# - terminal_run_command_wait, repo_command -> executor
# - vulkan_helper (OpenWebUI public) -> openwebui
# - rerank, semantic-search -> openvino

# =============================================================================
# ACTIVATION SCRIPTS
# =============================================================================

# PowerShell script per attivare il venv corretto:
# powershell -ExecutionPolicy Bypass -File activate-venv.ps1 -tool <tool_name>

# Python script per impostare PYTHONPATH dinamico:
