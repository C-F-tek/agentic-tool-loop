model_provider = "aicarmine_ollama_bridge"
model = "qwen3-coder:30b"
approval_policy = "on-request"
sandbox_mode = "workspace-write"

model_context_window = 65536
model_auto_compact_token_limit = 49152
tool_output_token_limit = 16000
model_reasoning_summary = "none"
model_supports_reasoning_summaries = false

[model_providers.aicarmine_ollama_bridge]
name = "AI-Carmine Ollama Bridge"
base_url = "http://127.0.0.1:3581/v1"
wire_api = "responses"
request_max_retries = 1
stream_max_retries = 1
stream_idle_timeout_ms = 600000

[mcp_servers.aicarmine_tools]
command = "python"
args = ["C:\\Users\\carmi\\AI\\services\\aicarmine_codex_mcp_server.py"]
cwd = "C:\\Users\\carmi\\AI"
env = {
  AICARMINE_VULKAN_AGENT_URL = "http://127.0.0.1:3572/vulkan/agent",
  AICARMINE_BROKER_BASE_URL = "http://127.0.0.1:3572",
  AICARMINE_LAB_REPO = "C:\\Users\\carmi\\AI",
  AICARMINE_USEFUL_TOOLS_ROOT = "C:\\Users\\carmi\\AI\\services\\useful_tools",
  AICARMINE_MCP_TOOL_TIMEOUT_SECONDS = "900"
}
startup_timeout_sec = 20
tool_timeout_sec = 900
enabled = true
required = true

enabled_tools = [
  "aicarmine_bridge_health",
  "aicarmine_repo_capabilities",
  "aicarmine_repo_status",
  "aicarmine_repo_tree",
  "aicarmine_repo_list_files",
  "aicarmine_repo_search",
  "aicarmine_repo_read",
  "aicarmine_repo_apply_patch",
  "aicarmine_repo_validate",
  "aicarmine_jobs_status",
  "aicarmine_job_detail",
  "aicarmine_memory_report",
  "aicarmine_memory_state_packet"
]

disabled_tools = [
  "aicarmine_vulkan_helper",
  "aicarmine_repo_command",
  "aicarmine_repo_write_file"
]

default_tools_approval_mode = "prompt"

[mcp_servers.aicarmine_tools.tools.aicarmine_bridge_health]
approval_mode = "approve"

[mcp_servers.aicarmine_tools.tools.aicarmine_repo_capabilities]
approval_mode = "approve"

